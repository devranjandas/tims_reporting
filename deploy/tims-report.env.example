# Settings for TIMS-Report. install.sh copies this to /etc/tims-report.env (mode 600).
TIMS_INSTANCE_DIR=/var/lib/tims-report
TIMS_BACKUP_DIR=/var/lib/tims-report/backups
TIMS_BACKUP_KEEP=14
TIMS_SESSION_MINUTES=30
# Set to 1 once the site is served over HTTPS (it should be).
TIMS_SECURE_COOKIES=1
# Element definitions and import formats live in the application folder by default.
# TIMS_ELEMENTS_DIR=/opt/tims-report/elements
# TIMS_IMPORT_PROFILES_DIR=/opt/tims-report/import_profiles
